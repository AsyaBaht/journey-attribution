__pycache__/
*.pyc
.env
.venv/
.idea

# data lake tiers — regenerable / pulled from BigQuery, not versioned.
# .gitkeep files keep the directory structure tracked.
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# standalone written-up report page (not generated by the pipeline)
reports/attribution.html

# packaging
*.egg-info/
build/
dist/

# test/tooling caches
.pytest_cache/
.ruff_cache/

# generated report output — regenerable via `journey-attribution --report`, not versioned.
reports/

# GCP credential files — should never live in the repo, only in ~/.config/gcloud
*-key.json
*service-account*.json
*credentials*.json
client_secret*.json
